<?xml version="1.0"?>
<launch>

    <!-- Load YAML parameters -->
    <rosparam file="$(find hw_t)/config/config_map.yaml" command="load"/>
    <rosparam file="$(find hw_t)/config/joint_limits.yaml" command="load"/>

    <!-- Robot description -->
    <arg name="model" default="$(find hw_t)/urdf/wheelcheck.urdf.xacro"/>
    <param name="robot_description" command="$(find xacro)/xacro $(arg model)" />

    <!-- Disable automatic odom TF if using custom odometry -->
    <!-- <param name="/taurus/mobile_base_controller/enable_odom_tf" type="bool" value="true"/> -->

    <!-- Taurus hardware node (direct Moons connection) -->
    <node name="taurus_node" pkg="hw_t" type="taurus_node" output="screen">
        <remap from="/taurus/mobile_base_controller/cmd_vel" to="/robot/cmd_vel"/>
    </node>

     <!-- <node
        name="plc_server" pkg="hw_t" type="plc_server" output="screen">
    </node> -->


    <node
        name="lift_action" pkg="hw_t" type="lift_action" output="screen">
    </node>

    <node
        name="conveyor_action" pkg="hw_t" type="conveyor_action" output="screen">
    </node>



    <!-- <arg name="lidar_ip" default="192.168.7.11"/>
  <arg name="lidar1_ip" default="192.168.7.10"/>
    <include file="$(find sick_scan)/launch/sick_tim_5xx_twin.launch">
    <arg name="hostname1" value="$(arg lidar_ip)"/>
    <arg name="hostname2" value="$(arg lidar1_ip)"/>  
    </include> -->

    <!-- laser driver (optional) -->
    <include file="$(find lsc_ros_driver)/launch/lsc_c25_launch.launch"/>

     <!-- Optional: EKF localization commented out -->
    
   

  

    <!-- Robot state publisher -->
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />

    <!-- <node name="joint_state_publisher_gui"
        pkg="joint_state_publisher_gui"
        type="joint_state_publisher_gui"/> -->


    <!-- Controller spawner -->
    <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen"
          args="/taurus/joints_update /taurus/mobile_base_controller" />

   
    

</launch>


